{
  "name": "pr-review",
  "version": "0.1.0",
  "description": "Review a local diff between two commits with Claude agents.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "bin": {
    "pr-review": "dist/cli.js"
  },
  "files": [
    "dist",
    "prompts"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src test && prettier --check src test",
    "test": "vitest run",
    "format": "prettier --write src test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "commander": "^14.0.3",
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "@types/picomatch": "^4.0.3",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11"
  }
}
